# ─────────────────────────────────────────
# ListingAI Backend — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://adabjoshi2005_db_user:zh4JSgN9vUjXVpSJ@cluster0.pwq0ory.mongodb.net/

# JWT
JWT_ACCESS_SECRET=replace_with_64_char_random_string_access
JWT_REFRESH_SECRET=replace_with_64_char_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Razorpay
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Logging
LOG_LEVEL=info
LOG_DIR=logs
